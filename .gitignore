# --- Python / Backend ---
__pycache__/
*.pyc
*.pyo
*.pyd
.env
.env.*
*.env
*.log

# Virtual environments
venv/
env/
plantdex-env/

# Local config
*.ini
*.cfg
*.toml
*.db

# Upload/temp folders
backend/server/uploads/
backend/tmp/
backend/cache/

# Image/model storage (ignore large raw dumps)
data/raw/
data/tmp/
data/cache/

# --- 3DS Homebrew / DevkitARM ---
frontend-3ds/build/
frontend-3ds/romfs/
frontend-3ds/*.smdh
frontend-3ds/*.elf
frontend-3ds/*.3dsx
frontend-3ds/output/

# Compiled objects
*.o
*.a
*.d
*.bin

# --- 3DS SD Card Backups ---
# Ignore full SD exports from GodMode9 or manual backups
3ds_sd_card/
sd_card_backup/
sd_backup_*/
*_sd_backup/
nintendo3ds/
DCIM/          # Raw 3DS photos folder (huge)
private/       # Nintendo system data
gm9/out/       # GodMode9 dump folder
gm9/in/

# Optional: ignore all .bin / .cia / .tik (system content)
*.cia
*.bin
*.tik

# Allow only curated test images
!data/sample_images/
!data/sample_images/**

# --- OS Noise ---
Thumbs.db
.DS_Store
ehthumbs.db
$RECYCLE.BIN/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo

# --- Misc ---
node_modules/
npm-debug.log
yarn-error.log
*.bak
*.tmp